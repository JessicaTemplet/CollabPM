<h1>Shared files</h1>

<ul>
  <% @files.each do |file| %>
    <li>
      <%= link_to file.filename.to_s, rails_blob_path(file, disposition: "attachment") %>
      <%= button_to "Remove", file_path(file), method: :delete, form: { style: "display:inline" } %>
    </li>
  <% end %>
</ul>

<%= form_with url: files_path, method: :post, multipart: true do |f| %>
  <%= f.file_field :file %>
  <%= f.submit "Upload" %>
<% end %>
