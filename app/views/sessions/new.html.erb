<h1>Sign in</h1>
<p>Signing in to <strong><%= Current.tenant&.name || request.subdomain %></strong>.</p>

<%= form_with url: session_path do |f| %>
  <%= f.label :email_address %>
  <%= f.email_field :email_address, autofocus: true %>

  <%= f.label :password %>
  <%= f.password_field :password %>

  <%= f.submit "Sign in" %>
<% end %>

<p><%= link_to "Forgot password?", new_password_path %></p>
