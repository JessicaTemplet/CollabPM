<div class="auth-shell">
  <div class="auth-card">
    <h1>Sign in</h1>
    <p class="subtitle">Signing in to <%= Current.tenant&.name || request.subdomain %>.</p>

    <%= form_with url: session_path do |f| %>
      <%= f.label :email_address %>
      <%= f.email_field :email_address, value: SessionsController::GUEST_EMAIL %>

      <%= f.label :password %>
      <%= f.text_field :password, value: SessionsController::GUEST_PASSWORD, autocomplete: "off" %>

      <%= f.submit "Try the demo →", class: "demo-submit", autofocus: true %>
      <p class="demo-hint">Guest login is already filled in. Just click or press Enter.</p>
    <% end %>

    <div class="auth-links">
      <%= link_to "Forgot password?", new_password_path %>
    </div>
  </div>
</div>
