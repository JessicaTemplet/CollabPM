<h1><%= @folder ? @folder.name : "Documents" %></h1>

<% if @folder %>
  <p><%= link_to "‹ Up", documents_path(folder_id: @folder.parent_id), class: "btn-quiet" %></p>
<% end %>

<% if @folders.any? %>
  <div class="tile-grid">
    <% @folders.each do |folder| %>
      <%= link_to documents_path(folder_id: folder.id), class: "card tile" do %>
        <span class="swatch"></span>
        <span class="name"><%= folder.name %></span>
      <% end %>
    <% end %>
  </div>
<% end %>

<% if @documents.any? %>
  <table>
    <thead><tr><th>Name</th><th>Created</th></tr></thead>
    <tbody>
      <% @documents.each do |document| %>
        <tr>
          <td><%= link_to document.title, document %></td>
          <td><%= document.created_at.strftime("%b %-d, %Y") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% elsif @folders.empty? %>
  <p class="empty-note">Nothing here yet.</p>
<% end %>

<h2>New folder</h2>
<%= form_with model: Folder.new, url: folders_path do |f| %>
  <%= f.hidden_field :parent_id, value: @folder&.id %>
  <%= f.label :name %>
  <%= f.text_field :name %>
  <%= f.submit "Create folder" %>
<% end %>

<p><%= link_to "New document", new_document_path(folder_id: @folder&.id), class: "btn-quiet" %></p>
