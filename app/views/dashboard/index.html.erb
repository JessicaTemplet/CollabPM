<h1>Dashboard</h1>
<p>Signed in as <%= Current.user.email_address %> at <%= Current.tenant.name %>.</p>

<div class="stat-grid">
  <% @stats.each do |stat| %>
    <div class="card stat-card">
      <div class="stat-value"><%= stat[:value] %></div>
      <div class="stat-label"><%= stat[:label] %></div>
    </div>
  <% end %>
</div>

<h2>Recent activity</h2>
<% if @activity.any? %>
  <div class="activity-list">
    <% @activity.each do |entry| %>
      <div class="card activity-row">
        <span class="who"><%= entry.actor.email_address %></span>
        <span class="action">
          <% case entry.action %>
          <% when "proposal.created" %>
            created proposal <%= link_to entry.subject.title, entry.subject if entry.subject %>
          <% when "proposal.status_changed" %>
            moved <%= link_to entry.subject.title, entry.subject if entry.subject %>
            from <%= entry.payload["from"] %> to <%= entry.payload["to"] %>
          <% else %>
            <%= entry.action.tr(".", " ") %>
          <% end %>
        </span>
        <span class="when"><%= time_ago_in_words(entry.created_at) %> ago</span>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="empty-note">Nothing yet.</p>
<% end %>
