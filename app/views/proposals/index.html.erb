<h1>Proposals</h1>

<p>
  <%= link_to "New proposal", new_proposal_path, class: "btn" %>
  <%= link_to "All", proposals_path, class: "btn-quiet" %>
  <%= link_to "My items", proposals_path(mine: 1), class: "btn-quiet" %>
</p>

<div class="kanban">
  <% Proposal::STATUSES.each do |status| %>
    <div class="kanban-col">
      <h2><%= status.titleize %></h2>
      <% @proposals_by_status[status].each do |proposal| %>
        <div class="card kanban-card">
          <%= link_to proposal.title, proposal %>
          <div class="meta">
            <%= proposal.assignee&.email_address || "Unassigned" %>
            <% if proposal.due_date %> &middot; due <%= proposal.due_date.strftime("%b %-d") %><% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
